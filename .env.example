# Copy to .env and adjust for your environment.
#
# SQLite connection string. In Docker the file lives at /data/support_crm.db
# (see Dockerfile). Railway: point this at a persistent volume.
DATABASE_URL=sqlite:///./data/support_crm.db

# Set to 0 to skip demo data on a fresh database (kept on by default for the demo).
AUTO_SEED_DEMO=1

# Comma-separated list of allowed CORS origins. "*" allows all (fine for a demo).
CORS_ORIGINS=*

# ---- Frontend (only used at build time of the Vite app) ----
# Base path used for API calls. Defaults to /api which FastAPI also serves.
# VITE_API_BASE=/api